{
  "target_language": "zh-Hans",
  "output_mode": "beside",
  "existing_policy": "skip",
  "source_policy": "ask",
  "background": true,
  "glossary_path": "",
  "default_engine": "deepl",
  "source_language": "ja",
  "input_dir": "",
  "output_dir": "",
  "recursive": false,
  "retries": 3,
  "timeout": 60,
  "batch_items": 20,
  "batch_chars": 4000,
  "context_items": 3,
  "request_interval": 1.0,
  "providers": {},
  "transcription": {
    "image": "whisper-subtitles:rocm",
    "model": "large-v3",
    "compute_type": "float16",
    "vad": true,
    "threshold": 0.6,
    "min_speech_duration_ms": 250,
    "min_silence_duration_ms": 700,
    "speech_pad_ms": 300,
    "max_speech_duration_s": 25,
    "beam_size": 5,
    "temperature": 0.0,
    "condition_on_previous_text": false,
    "word_timestamps": false,
    "no_speech_threshold": 0.6,
    "log_prob_threshold": -1.0,
    "compression_ratio_threshold": 2.4,
    "cache_dir": "~/whisper-subtitles/cache"
  }
}
